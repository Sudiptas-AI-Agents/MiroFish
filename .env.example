# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 图谱后端 =====
# graphiti（默认，自托管 Neo4j，无需 ZEP_API_KEY）或 zep（Zep Cloud）
GRAPH_BACKEND=graphiti
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
# 通过 LLM_BASE_URL 调用的 OpenAI 兼容 embedding 模型
EMBEDDING_MODEL_NAME=your_embedding_model_here
EMBEDDING_DIM=768
# Graphiti 并发上限（LLM / embedding）
GRAPHITI_MAX_CONCURRENCY=3
GRAPHITI_EMBED_CONCURRENCY=2
# 模拟与人设生成的 LLM 并发上限（0 = 使用默认值）
LLM_MAX_CONCURRENCY=3

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# Flask session secret (generate your own, the code default is insecure)
SECRET_KEY=your_secret_key_here
